---
// Site root: forward to the default language (English). A static
// meta-refresh keeps this working on plain static hosts (GitHub Pages)
// under any `base` ('/' or '/<repo>/') — the relative './en/' target
// resolves against the deployed base automatically.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>VW EPS Specifications (RIF) — redirecting…</title>
    <meta http-equiv="refresh" content="0;url=./en/" />
    <link rel="canonical" href="./en/" />
  </head>
  <body>
    <p>
      Redirecting to the English documentation… <a href="./en/">Continue to /en/</a>
      · <a href="./de/">Deutsch /de/</a>
    </p>
  </body>
</html>
